# PostgreSQL connection URL for a dedicated read-only user.
FLOWPROOF_POSTGRES_URL=postgresql://flowproof_reader:replace-me@localhost:5432/app

# Snowflake connection for a dedicated least-privilege role.
FLOWPROOF_SNOWFLAKE_ACCOUNT=org-account
FLOWPROOF_SNOWFLAKE_USER=FLOWPROOF_READER
FLOWPROOF_SNOWFLAKE_PASSWORD=replace-me
# Production alternative: use key-pair authentication instead of a password.
# FLOWPROOF_SNOWFLAKE_PRIVATE_KEY_PATH=/absolute/path/to/rsa_key.p8
# FLOWPROOF_SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=replace-me
FLOWPROOF_SNOWFLAKE_WAREHOUSE=FLOWPROOF_WH
FLOWPROOF_SNOWFLAKE_DATABASE=ANALYTICS
FLOWPROOF_SNOWFLAKE_SCHEMA=RAW
FLOWPROOF_SNOWFLAKE_ROLE=FLOWPROOF_READER

# Test-only WAL relay. Use separate source replication and target writer users.
FLOWPROOF_RELAY_POSTGRES_URL=postgresql://openflow_connector:replace-me@localhost:5433/flowproof_pilot
FLOWPROOF_RELAY_SNOWFLAKE_ACCOUNT=org-account
FLOWPROOF_RELAY_SNOWFLAKE_USER=FLOWPROOF_RELAY
FLOWPROOF_RELAY_SNOWFLAKE_PASSWORD=replace-me
# FLOWPROOF_RELAY_SNOWFLAKE_PRIVATE_KEY_PATH=/absolute/path/to/relay_rsa_key.p8
# FLOWPROOF_RELAY_SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=replace-me
FLOWPROOF_RELAY_SNOWFLAKE_WAREHOUSE=FLOWPROOF_PILOT_WH
FLOWPROOF_RELAY_SNOWFLAKE_DATABASE=FLOWPROOF_PILOT
FLOWPROOF_RELAY_SNOWFLAKE_SCHEMA=RAW
FLOWPROOF_RELAY_SNOWFLAKE_ROLE=FLOWPROOF_RELAY_ROLE

# Optional, partial serverless-task compute estimate. This remains UNKNOWN
# until storage, transfer, and other pipeline compute are also attributed.
FLOWPROOF_SNOWFLAKE_TASK_NAME=APPLY_MIRROR_ORDERS
FLOWPROOF_SNOWFLAKE_CREDIT_RATE_USD=3.00
