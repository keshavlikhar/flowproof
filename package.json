{
  "name": "flowproof",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Evidence-based delivery assurance for PostgreSQL to Snowflake pipelines",
  "bin": {
    "flowproof": "./src/cli.ts"
  },
  "scripts": {
    "audit": "node src/cli.ts audit --config examples/flowproof.json --snapshot examples/snapshot.json",
    "plan": "node src/cli.ts plan --config examples/flowproof.json",
    "test": "node --test tests/*.test.ts",
    "check": "npm test && npm run audit && npm run plan"
  },
  "engines": {
    "node": ">=22.6"
  },
  "keywords": [
    "cdc",
    "snowflake",
    "postgresql",
    "data-quality",
    "reconciliation"
  ],
  "dependencies": {
    "pg": "^8.23.0",
    "snowflake-sdk": "^3.2.0"
  }
}
