{
  "version": 2,
  "pipeline": {
    "name": "postgres-orders-to-transformed-snowflake",
    "policy": "pilot",
    "rowCountTolerancePercent": 0,
    "maxLagSeconds": 300,
    "monthlyCostBudgetUsd": 500
  },
  "reconciliation": {
    "settleDelaySeconds": 120,
    "maxRowsPerTable": 1000000,
    "sourceStabilityCheck": true,
    "maxMismatchBuckets": 5,
    "maxMismatchRowsPerBucket": 1000
  },
  "tables": [
    {
      "source": "public.orders",
      "target": "ANALYTICS.ORDERS",
      "primaryKey": ["id"],
      "targetPrimaryKey": ["order_id"],
      "freshnessColumn": "updated_at",
      "targetFreshnessColumn": "source_updated_at",
      "columnComparisons": [
        { "source": "id", "target": "order_id" },
        {
          "source": "status_code",
          "target": "status",
          "normalize": "uppercase-trim",
          "valueMap": { "P": "PAID", "S": "SHIPPED" }
        },
        { "source": "amount", "target": "order_amount" },
        { "source": "updated_at", "target": "source_updated_at" }
      ],
      "targetSoftDeleteColumn": "_SNOWFLAKE_DELETED",
      "targetApplyTimestampColumn": "_SNOWFLAKE_UPDATED_AT"
    }
  ]
}
